# ==== PostgreSQL ====
POSTGRES_USER=dataops
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=dataops_copilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==== Qdrant ====
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# ==== LLM (Ollama) ====
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# ==== Embeddings ====
# bge-small-en-v1.5 : documents en anglais uniquement
# paraphrase-multilingual-MiniLM-L12-v2 : documents en français/multilingue (utilisé pour ce projet)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ==== API ====
API_HOST=0.0.0.0
API_PORT=8000

# ==== n8n ====
N8N_HOST=n8n
N8N_PORT=5678